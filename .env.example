# Строка подключения к Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Ключи Web Push — сгенерировать: uv run python gen_vapid_keys.py
# Без них сервис работает, но уведомления выключены.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Как часто (в секундах) проверять появление новых картинок
WATCH_INTERVAL_SEC=10
