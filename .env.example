# Строка подключения к Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Ключи Web Push — сгенерировать: uv run python -m src.services.vapid
# Без них сервис работает, но уведомления выключены.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Как часто (в секундах) проверять появление новых картинок
WATCH_INTERVAL_SEC=10

# Уровень логирования: на INFO видно работу наблюдателя и рассылку push
LOG_LEVEL=INFO
